{
  "name": "TubeArchivist TV",
  "description": "10-foot client for your self-hosted TubeArchivist: pair from your phone, never type on the remote. Needs the project's gateway and transcoder containers on your LAN; the gateway URL is written into the package on install.",
  "category": "media",
  "repo": "raykholo/tubearchivist-tv",
  "source": "build",
  "branch": "main",
  "project_path": "tizen-app",
  "skip_npm": true,
  "pre_build": "sed -i 's/__TATV_HOST__ \\*/*/' tizen-app/config.xml",
  "output_name": "TubeArchivist-TV.wgt",
  "user_settings": {
    "help_url": "https://github.com/raykholo/tubearchivist-tv/blob/main/docs/tv-install.md",
    "file": "index.html",
    "fields": [
      {
        "key": "gateway_url",
        "label": "Gateway URL (e.g. http://192.168.1.10:8090/)",
        "type": "text",
        "required": true,
        "pattern": "^https?://",
        "find": "var TARGET = '__TATV_URL__';",
        "replace": "var TARGET = '{value}';"
      }
    ]
  }
}
