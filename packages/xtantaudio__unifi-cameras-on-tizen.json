{
  "name": "UniFi Cameras",
  "description": "Live camera grid for UniFi Protect or any RTSP cameras on Samsung Tizen 6.0+ TVs, D-pad to go fullscreen. Needs the project's restreamer (ffmpeg and Python) on an always-on LAN host; its address is written into the package on install.",
  "category": "casting",
  "repo": "xtantaudio/unifi-cameras-on-tizen",
  "source": "build",
  "branch": "main",
  "project_path": "app",
  "pre_build": "cp app/js/config.example.js app/js/config.js",
  "output_name": "UniFi-Cameras.wgt",
  "user_settings": {
    "help_url": "https://github.com/xtantaudio/unifi-cameras-on-tizen#readme",
    "file": "js/config.js",
    "fields": [
      {
        "key": "restreamer_host",
        "label": "Restreamer address (e.g. http://192.168.1.50:8099)",
        "type": "text",
        "required": true,
        "pattern": "^https?://[^\\s'\\\"\\\\]+$",
        "find": "host: \"http://CHANGE_ME:8099\"",
        "replace": "host: \"{value}\""
      }
    ]
  }
}
