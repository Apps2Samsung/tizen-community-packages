{
  "name": "Nuvio Native Legacy",
  "description": "Unofficial native C/SDL2 Nuvio client, fast on older TVs. Native .tpk per Tizen version (4.0-5.5, 6.0, 6.5-7, 8-9) plus a WebAssembly .wgt for Tizen 5.5+.",
  "repo": "iqui27/nuvio-native-legacy",
  "repo_label": "iqui27",
  "source": "release",
  "branch": "master",
  "assets": [
    { "match": "-NuvioTpk40[.]tpk$", "output_name": "Nuvio-Legacy-tizen4.tpk" },
    { "match": "-NuvioTpk60[.]tpk$", "output_name": "Nuvio-Legacy-tizen6.tpk" },
    { "match": "-NuvioTpk65[.]tpk$", "output_name": "Nuvio-Legacy-tizen6.5.tpk" },
    { "match": "-NuvioTpk[.]tpk$",   "output_name": "Nuvio-Legacy-tizen8.tpk" },
    { "match": "^NuvioTV-.*-tizen[.]wgt$", "output_name": "Nuvio-Legacy.wgt" }
  ]
}
