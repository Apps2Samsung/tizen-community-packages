{
  "name": "Baobab Signage",
  "description": "Player for Baobab, open-source local digital signage: plays the playlist your own Baobab server on the LAN assigns to this screen. Server URL and screen key are written into the package on install.",
  "category": "other",
  "repo": "Gonqas/baobab",
  "source": "build",
  "branch": "main",
  "project_path": "tv-app",
  "skip_npm": true,
  "output_name": "Baobab.wgt",
  "user_settings": {
    "help_url": "https://github.com/Gonqas/baobab#readme",
    "file": "js/config.js",
    "fields": [
      {
        "key": "api_base_url",
        "label": "Baobab server URL (e.g. http://192.168.1.10:4000)",
        "type": "text",
        "required": true,
        "pattern": "^https?://",
        "find": "API_BASE_URL: '',",
        "replace": "API_BASE_URL: '{value}',"
      },
      {
        "key": "screen_key",
        "label": "Screen key (e.g. display-1)",
        "type": "text",
        "required": true,
        "find": "SCREEN_KEY: '',",
        "replace": "SCREEN_KEY: '{value}',"
      }
    ]
  }
}
