{
  "name": "Immich TV",
  "description": "Read-only Immich photo and video client for Samsung TVs: timeline, albums, people, memories, search, slideshows.",
  "category": "media",
  "repo": "rfsmason/immich-tv-for-samsung",
  "repo_label": "Immich TV for Samsung",
  "source": "release",
  "branch": "main",
  "assets": [
    {
      "match": "^ImmichTV-.*-unsigned\\.wgt$",
      "output_name": "ImmichTV.wgt"
    }
  ],
  "user_settings": {
    "help_url": "https://github.com/rfsmason/immich-tv-for-samsung#required-api-key-permissions",
    "file": "scripts/install-preset.js",
    "fields": [
      {
        "key": "server_url",
        "label": "Immich server URL",
        "type": "text",
        "required": false,
        "pattern": "^https?://\\S+$",
        "find": "serverUrl: \"\"",
        "replace": "serverUrl: \"{value}\""
      },
      {
        "key": "api_key",
        "label": "Immich API key (read-only recommended)",
        "type": "text",
        "required": false,
        "find": "apiKey: \"\"",
        "replace": "apiKey: \"{value}\""
      }
    ]
  }
}
