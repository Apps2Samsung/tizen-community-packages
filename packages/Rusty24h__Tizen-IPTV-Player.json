{
  "name": "Tizen IPTV Player (Rusty24h)",
  "description": "IPTV Player for Samsung Tizen TVs supporting Stalker MAC portals, Xtream Codes, and M3U playlists with 2D EPG and catch-up.",
  "category": "iptv",
  "repo": "Rusty24h/Tizen-IPTV-Player",
  "source": "release",
  "branch": "main",
  "cert_level": "partner",
  "assets": [
    {
      "match": "^SmartSTBcloneV2[.]wgt$",
      "variant": "v2.1.0 (Latest)",
      "output_name": "SmartSTBcloneV2.wgt"
    },
    {
      "match": "^SmartSTBcloneV2-v2[.]0[.]0[.]wgt$",
      "variant": "v2.0.0 (Stable)",
      "output_name": "SmartSTBcloneV2-v2.0.0.wgt"
    }
  ]
}
